//@version=6
indicator("Algo Options Master - Gemini Pro", overlay=true, max_labels_count=500)

// =========================================================================
// INPUTS & PARAMETERS
// =========================================================================
grp_risk = "Risk / Reward Management"
sl_buffer= input.float(10.0, "SL Buffer Points", group=grp_risk)

grp_mtf  = "Multi-Timeframe Confirmation"
use_mtf  = input.bool(true, "Enable 15m Trend Filter", group=grp_mtf)
mtf_res  = input.timeframe("15", "MTF Timeframe", group=grp_mtf)

grp_smc  = "Advanced SMC Visuals"
show_sweeps = input.bool(true, "Show Liquidity Sweeps", group=grp_smc)

grp_ma   = "Moving Averages"
len_ema9 = input.int(9,  "EMA 9 Length", group=grp_ma)
len_ema20= input.int(20, "EMA 20 Length", group=grp_ma)
len_ema50= input.int(50, "EMA 50 Length", group=grp_ma)

// =========================================================================
// CORE INDICATORS
// =========================================================================
ema9  = ta.ema(close, len_ema9)
ema20 = ta.ema(close, len_ema20)
ema50 = ta.ema(close, len_ema50)
atr   = ta.atr(14)

// MTF Trend Confirmation
ema20_mtf = request.security(syminfo.tickerid, mtf_res, ta.ema(close, 20))
ema50_mtf = request.security(syminfo.tickerid, mtf_res, ta.ema(close, 50))
mtf_bullish = ema20_mtf > ema50_mtf
mtf_bearish = ema20_mtf < ema50_mtf

// VWAP & Volume
vwapValue = ta.vwap(close)
vwapStdev = ta.stdev(close, 50) 
vwapUpper = vwapValue + (vwapStdev * 2.5)
vwapLower = vwapValue - (vwapStdev * 2.5)
volAvg = ta.sma(volume, 20)
rsiVal = ta.rsi(close, 14)

// =========================================================================
// REGIME & SMC (Liquidity Sweeps)
// =========================================================================
atr_pct = atr / close
regime = "CHOPPY"
ema_bullish = (ema9 > ema20) and (ema20 > ema50)
ema_bearish = (ema9 < ema20) and (ema20 < ema50)

high20 = ta.highest(high, 20)
low20  = ta.lowest(low, 20)

if atr_pct > 0.015
    regime := "VOLATILE"
else if ema_bullish and (not use_mtf or mtf_bullish)
    regime := "TRENDING_UP"
else if ema_bearish and (not use_mtf or mtf_bearish)
    regime := "TRENDING_DOWN"
else
    regime := "CHOPPY"

// SMC: Liquidity Sweep Detection
sweep_high = high > high20[1] and close < high20[1]
sweep_low  = low < low20[1] and close > low20[1]
plotshape(show_sweeps and sweep_high, "Liquidity Sweep High", shape.triangledown, location.abovebar, color.red, size=size.tiny)
plotshape(show_sweeps and sweep_low, "Liquidity Sweep Low", shape.triangleup, location.belowbar, color.green, size=size.tiny)

// =========================================================================
// TRADING LOGIC
// =========================================================================
vwap_touch_long  = (low <= vwapValue * 1.001) and (close > vwapValue)
vwap_touch_short = (high >= vwapValue * 0.999) and (close < vwapValue)

// Combine Logic
long_cond  = (regime == "TRENDING_UP" and vwap_touch_long and volume >= volAvg * 0.8) or (regime == "CHOPPY" and close < vwapLower and rsiVal < 25)
short_cond = (regime == "TRENDING_DOWN" and vwap_touch_short and volume >= volAvg * 0.8) or (regime == "CHOPPY" and close > vwapUpper and rsiVal > 75)

// =========================================================================
// POSITION EXECUTION & LABELS
// =========================================================================
var int position = 0 
var float entry_price = 0.0
var float trailing_sl = 0.0
var float session_pnl = 0.0
var int total_trades = 0
var int win_trades = 0

// Entry Logic
if long_cond and position <= 0
    position := 1
    entry_price := close
    trailing_sl := low - sl_buffer
    label.new(bar_index, low, text="LONG\n" + str.tostring(entry_price, "#.##") + "\nSL: " + str.tostring(trailing_sl, "#.##"), style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
else if short_cond and position >= 0
    position := -1
    entry_price := close
    trailing_sl := high + sl_buffer
    label.new(bar_index, high, text="SHORT\n" + str.tostring(entry_price, "#.##") + "\nSL: " + str.tostring(trailing_sl, "#.##"), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// Trailing Logic
if position == 1
    trailing_sl := math.max(trailing_sl, low - sl_buffer)
else if position == -1
    trailing_sl := math.min(trailing_sl, high + sl_buffer)

// Exit Conditions
exit_long  = position == 1 and close <= trailing_sl
exit_short = position == -1 and close >= trailing_sl

if exit_long
    pnl = close - entry_price
    session_pnl += pnl
    total_trades += 1
    if pnl > 0
        win_trades += 1
    label.new(bar_index, high, text="EXIT LONG\nExit: " + str.tostring(close, "#.##") + "\nP&L: " + str.tostring(pnl, "#.##"), style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)
    position := 0
    entry_price := 0.0

if exit_short
    pnl = entry_price - close
    session_pnl += pnl
    total_trades += 1
    if pnl > 0
        win_trades += 1
    label.new(bar_index, low, text="EXIT SHORT\nExit: " + str.tostring(close, "#.##") + "\nP&L: " + str.tostring(pnl, "#.##"), style=label.style_label_up, color=color.gray, textcolor=color.white, size=size.small)
    position := 0
    entry_price := 0.0

// =========================================================================
// DASHBOARD TABLE
// =========================================================================
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Metric", text_color=color.white)
    table.cell(dash, 1, 0, "Value", text_color=color.white)
    table.cell(dash, 0, 1, "Session P&L", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(session_pnl, "#.##"), text_color=session_pnl >= 0 ? color.green : color.red)
    table.cell(dash, 0, 2, "Win Rate", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(total_trades > 0 ? (win_trades / total_trades) * 100 : 0, "#.#") + "%", text_color=color.white)
    table.cell(dash, 0, 3, "Regime", text_color=color.white)
    table.cell(dash, 1, 3, regime, text_color=regime == "CHOPPY" ? color.yellow : color.green)
