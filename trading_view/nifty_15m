// =====================================================================================
//  NIFTY INSTITUTIONAL HUNTER  —  15 MINUTE SWING-INTRADAY EDITION
//  Pine Script v6  |  Strategy + Indicator (toggleable)
//  Author: Emergent Labs (E1)
//  Version: 1.0.0
//
//  Tuned defaults for 15m swing-intraday on NIFTY / BANKNIFTY:
//   - Larger pivots, wider SLs, elite R:R targets (1:2 / 1:4 / 1:7)
//   - HTF bias on 60m, HTF trend on Daily
//   - Larger opening range (15 min)
//   - Higher score threshold for elite-only entries
//
//  Philosophy: "Trade less. Trade smarter. Trade where institutions leave footprints."
// =====================================================================================
//@version=6
strategy("NIFTY Institutional Hunter [15m]",
     shorttitle           = "NIH-15m",
     overlay              = true,
     pyramiding           = 0,
     process_orders_on_close = true,
     calc_on_order_fills  = true,
     max_lines_count      = 500,
     max_labels_count     = 500,
     max_boxes_count      = 500)

// =====================================================================================
// SECTION 1 — GLOBAL INPUTS
// =====================================================================================
GRP_GEN  = "═══ General ═══"
GRP_MOD  = "═══ Module Toggles ═══"
GRP_STR  = "═══ Phase 1 · Market Structure ═══"
GRP_BOS  = "═══ Phase 2 · BOS / CHOCH ═══"
GRP_LIQ  = "═══ Phase 3 · Liquidity Engine ═══"
GRP_SR   = "═══ Phase 4 · S/R Zones ═══"
GRP_SMC  = "═══ Phase 5 · Order Blocks ═══"
GRP_FVG  = "═══ Phase 6 · Fair Value Gaps ═══"
GRP_CDL  = "═══ Phase 7 · Candle Psychology ═══"
GRP_TRD  = "═══ Phase 8 · EMA Trend ═══"
GRP_MOM  = "═══ Phase 9 · Momentum ═══"
GRP_VOL  = "═══ Phase 10 · Volatility ═══"
GRP_ORB  = "═══ Phase 11 · Opening Range ═══"
GRP_BNF  = "═══ Phase 12 · BANKNIFTY Correlation ═══"
GRP_VWP  = "═══ Phase 13 · VWAP ═══"
GRP_MTF  = "═══ Phase 14 · Multi-Timeframe ═══"
GRP_SCO  = "═══ Phase 15 · Trade Scoring ═══"
GRP_RSK  = "═══ Risk Management ═══"
GRP_VIS  = "═══ Visualization ═══"

mode            = input.string("Strategy", "Operating Mode", options=["Strategy","Indicator"], group=GRP_GEN)
sessionFilter   = input.session("0915-1500", "Trading Session (IST)", group=GRP_GEN)
useSessionGuard = input.bool(true,  "Restrict trades to session", group=GRP_GEN)
allowLong       = input.bool(true,  "Allow Long entries",  group=GRP_GEN)
allowShort      = input.bool(true,  "Allow Short entries", group=GRP_GEN)
oneTradePerBar  = input.bool(true,  "One trade per bar",   group=GRP_GEN)

useStructure    = input.bool(true,  "Market Structure",        group=GRP_MOD)
useBOS          = input.bool(true,  "BOS / CHOCH",             group=GRP_MOD)
useLiquidity    = input.bool(true,  "Liquidity Sweeps",        group=GRP_MOD)
useSR           = input.bool(true,  "S/R Zones",               group=GRP_MOD)
useOB           = input.bool(true,  "Order Blocks",            group=GRP_MOD)
useFVG          = input.bool(true,  "Fair Value Gaps",         group=GRP_MOD)
useCandle       = input.bool(true,  "Candle Psychology",       group=GRP_MOD)
useTrend        = input.bool(true,  "EMA Trend",               group=GRP_MOD)
useMomentum     = input.bool(true,  "Momentum Filter",         group=GRP_MOD)
useVolatility   = input.bool(true,  "ATR / Volatility",        group=GRP_MOD)
useORB          = input.bool(true,  "Opening Range Breakout",  group=GRP_MOD)
useBNF          = input.bool(true,  "BANKNIFTY Correlation",   group=GRP_MOD)
useVWAP         = input.bool(true,  "VWAP Engine",             group=GRP_MOD)
useMTF          = input.bool(true,  "Multi-Timeframe Bias",    group=GRP_MOD)
useFakeout      = input.bool(true,  "Fakeout Filter",          group=GRP_MOD)

// Phase 1 — Structure (slower for 15m)
pivotLen        = input.int(12,   "Pivot Length",                minval=2, maxval=50, group=GRP_STR)
showStructure   = input.bool(true,"Plot structure labels",       group=GRP_STR)

// Phase 2 — BOS/CHOCH (larger displacement required)
bosMinDispATR   = input.float(0.7,"Min Displacement (× ATR)",    step=0.1, group=GRP_BOS)
requireVolBOS   = input.bool(true,"Require Volume Spike on BOS", group=GRP_BOS)

// Phase 3 — Liquidity
liqLookback     = input.int(30,   "Liquidity Lookback Bars",     group=GRP_LIQ)
liqEqTolATR     = input.float(0.12,"Equal H/L Tolerance (× ATR)",step=0.05,group=GRP_LIQ)
liqMinTouches   = input.int(2,    "Min Touches to mark pool",    group=GRP_LIQ)

// Phase 4 — S/R
showPDHL        = input.bool(false,"Plot PDH / PDL",             group=GRP_SR)
showPWHL        = input.bool(false,"Plot PWH / PWL",             group=GRP_SR)
showRoundLvls   = input.bool(false,"Plot psychological levels",  group=GRP_SR)
roundStep       = input.int(100,  "Psych Level Step (pts)",      group=GRP_SR)

// Phase 5 — Order Blocks
obLookback      = input.int(20,   "OB Lookback",                 group=GRP_SMC)
obMaxAge        = input.int(200,  "OB Max Age (bars)",           group=GRP_SMC)
obShow          = input.bool(true,"Plot Order Blocks",           group=GRP_SMC)

// Phase 6 — FVG
fvgMinSizeATR   = input.float(0.30,"Min FVG Size (× ATR)",       step=0.05, group=GRP_FVG)
fvgMaxAge       = input.int(150,   "FVG Max Age (bars)",         group=GRP_FVG)
fvgShow         = input.bool(true, "Plot Fair Value Gaps",       group=GRP_FVG)

// Phase 7 — Candles
dispBodyATR     = input.float(1.3,"Displacement Body (× ATR)",   step=0.1, group=GRP_CDL)
absorbWickPct   = input.float(0.65,"Absorption Wick %",          step=0.05,group=GRP_CDL)

// Phase 8 — EMA
ema1Len         = input.int(9,    "EMA Fast",     group=GRP_TRD)
ema2Len         = input.int(21,   "EMA Mid",      group=GRP_TRD)
ema3Len         = input.int(50,   "EMA Slow",     group=GRP_TRD)
ema4Len         = input.int(200,  "EMA Anchor",   group=GRP_TRD)

// Phase 9 — Momentum (stricter for 15m)
rsiLen          = input.int(14,   "RSI Length",          group=GRP_MOM)
rsiBull         = input.int(56,   "RSI Bull Threshold",  group=GRP_MOM)
rsiBear         = input.int(44,   "RSI Bear Threshold",  group=GRP_MOM)
adxLen          = input.int(14,   "ADX Length",          group=GRP_MOM)
adxMin          = input.float(22, "ADX Minimum", step=1, group=GRP_MOM)

// Phase 10 — Volatility
atrLen          = input.int(20,   "ATR Length",                 group=GRP_VOL)
atrSqueezeLen   = input.int(60,   "Squeeze Lookback",           group=GRP_VOL)
atrSqueezePct   = input.float(0.7,"Squeeze ATR < X * Avg", step=0.05, group=GRP_VOL)

// Phase 11 — ORB (full opening 15-min bar uses first 1-bar; default 15-min window)
orbStart        = input.session("0915-0930","Opening Range Window (IST)", group=GRP_ORB)
orbBuffer       = input.float(0.08,"ORB Break Buffer (× ATR)",  step=0.05, group=GRP_ORB)

// Phase 12 — BANKNIFTY
bnfSymbol       = input.symbol("NSE:BANKNIFTY","BANKNIFTY Symbol", group=GRP_BNF)
bnfRequireAlign = input.bool(true,"Require BNF alignment",         group=GRP_BNF)

// Phase 13 — VWAP
vwapDevMult     = input.float(2.0,"VWAP Band Deviation", step=0.1, group=GRP_VWP)

// Phase 14 — MTF (higher anchors for 15m)
htfBias         = input.timeframe("60", "HTF Bias TF",  group=GRP_MTF)
htfTrend        = input.timeframe("D",  "HTF Trend TF", group=GRP_MTF)

// Phase 15 — Scoring (elite-only)
minScore        = input.int(7, "Minimum Score (0-10)", minval=1, maxval=10, group=GRP_SCO)
showDashboard   = input.bool(false, "Show Live Dashboard", group=GRP_SCO)

// Risk (swing defaults)
riskMode        = input.string("Swing", "SL Method", options=["ATR","Swing","Liquidity"], group=GRP_RSK)
atrSLmult       = input.float(1.8, "SL = X × ATR",     step=0.1, group=GRP_RSK)
tp1RR           = input.float(2.0, "TP1 R:R",          step=0.1, group=GRP_RSK)
tp2RR           = input.float(4.0, "TP2 R:R",          step=0.1, group=GRP_RSK)
tp3RR           = input.float(7.0, "Runner R:R",       step=0.1, group=GRP_RSK)
tp1Pct          = input.int(30,    "TP1 % closed", minval=10, maxval=80, group=GRP_RSK)
tp2Pct          = input.int(40,    "TP2 % closed", minval=10, maxval=80, group=GRP_RSK)
minRR           = input.float(2.5, "Min Acceptable R:R", step=0.1, group=GRP_RSK)
useBE           = input.bool(true, "Move SL to BE after TP1", group=GRP_RSK)
useTrail        = input.bool(true, "Trail SL after TP2",      group=GRP_RSK)
trailAtrMult    = input.float(1.5, "Trail ATR mult", step=0.1, group=GRP_RSK)

// Vis
showLines       = input.bool(true, "Show SL / TP lines",     group=GRP_VIS)
showSignalText  = input.bool(false, "Show Signal Tooltips",  group=GRP_VIS)
compactVisuals  = input.bool(true, "Compact chart visuals",  group=GRP_VIS)
colBull         = input.color(color.new(#00d4aa, 0), "Bullish",  group=GRP_VIS)
colBear         = input.color(color.new(#ff3b69, 0), "Bearish",  group=GRP_VIS)
colNeutral      = input.color(color.new(#8892b0, 0), "Neutral",  group=GRP_VIS)
colOB_B         = input.color(color.new(#00d4aa, 78),"OB Bull",  group=GRP_VIS)
colOB_S         = input.color(color.new(#ff3b69, 78),"OB Bear",  group=GRP_VIS)
colFVG_B        = input.color(color.new(#3aafff, 82),"FVG Bull", group=GRP_VIS)
colFVG_S        = input.color(color.new(#ff8b3a, 82),"FVG Bear", group=GRP_VIS)
colLiq          = input.color(color.new(#f5d76e, 70),"Liquidity",group=GRP_VIS)

// =====================================================================================
// SECTION 2 — UTILITIES
// =====================================================================================
isStrategy = mode == "Strategy"
f_inSession(_s) => not useSessionGuard or not na(time(timeframe.period, _s))
inSession   = f_inSession(sessionFilter)

atr         = ta.atr(atrLen)
avgVol      = ta.sma(volume, 20)
volSpike    = volume > avgVol * 1.4
bodySize    = math.abs(close - open)
upperWick   = high - math.max(close, open)
lowerWick   = math.min(close, open) - low
rangeBar    = high - low

// =====================================================================================
// SECTION 3 — PHASE 1 : STRUCTURE
// =====================================================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow (low,  pivotLen, pivotLen)

var float lastSwingHigh   = na
var float prevSwingHigh   = na
var float lastSwingLow    = na
var float prevSwingLow    = na

if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph
if not na(pl)
    prevSwingLow  := lastSwingLow
    lastSwingLow  := pl

isHH = not na(ph) and not na(prevSwingHigh) and ph > prevSwingHigh
isLH = not na(ph) and not na(prevSwingHigh) and ph < prevSwingHigh
isHL = not na(pl) and not na(prevSwingLow)  and pl > prevSwingLow
isLL = not na(pl) and not na(prevSwingLow)  and pl < prevSwingLow

var int structureBias = 0
if isHH or isHL
    structureBias := 1
if isLH or isLL
    structureBias := -1

// Structure labels (HH/LH/HL/LL)
if showStructure and useStructure and not compactVisuals
    if isHH
        label.new(bar_index - pivotLen, ph, "HH", style=label.style_label_down, color=color.new(colBull, 70), textcolor=color.white, size=size.tiny)
    if isLH
        label.new(bar_index - pivotLen, ph, "LH", style=label.style_label_down, color=color.new(colBear, 70), textcolor=color.white, size=size.tiny)
    if isHL
        label.new(bar_index - pivotLen, pl, "HL", style=label.style_label_up,   color=color.new(colBull, 70), textcolor=color.white, size=size.tiny)
    if isLL
        label.new(bar_index - pivotLen, pl, "LL", style=label.style_label_up,   color=color.new(colBear, 70), textcolor=color.white, size=size.tiny)

// =====================================================================================
// SECTION 4 — PHASE 2 : BOS / CHOCH
// =====================================================================================
displacementOK = bodySize > atr * bosMinDispATR
volOK          = not requireVolBOS or volSpike

bosBull = useBOS and not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh and displacementOK and volOK
bosBear = useBOS and not na(lastSwingLow)  and close < lastSwingLow  and close[1] >= lastSwingLow  and displacementOK and volOK

var int internalTrend = 0
chochBull = bosBull and internalTrend == -1
chochBear = bosBear and internalTrend ==  1
if bosBull
    internalTrend := 1
if bosBear
    internalTrend := -1

if useBOS and showStructure and not compactVisuals
    if bosBull
        label.new(bar_index, high + atr*0.4, chochBull ? "CHoCH↑" : "BOS↑", color=color.new(colBull, 30), textcolor=color.white, size=size.small, style=label.style_label_down)
    if bosBear
        label.new(bar_index, low  - atr*0.4, chochBear ? "CHoCH↓" : "BOS↓", color=color.new(colBear, 30), textcolor=color.white, size=size.small, style=label.style_label_up)

// =====================================================================================
// SECTION 5 — PHASE 3 : LIQUIDITY
// =====================================================================================
hh40 = ta.highest(high, liqLookback)
ll40 = ta.lowest(low,  liqLookback)

var int touchHigh = 0
var int touchLow  = 0
touchHigh := 0
touchLow  := 0
for i = 0 to liqLookback - 1
    if math.abs(high[i] - hh40) <= atr * liqEqTolATR
        touchHigh += 1
    if math.abs(low[i]  - ll40) <= atr * liqEqTolATR
        touchLow  += 1

liqHighActive = useLiquidity and touchHigh >= liqMinTouches
liqLowActive  = useLiquidity and touchLow  >= liqMinTouches

sweepHigh = liqHighActive and high > hh40 and close < hh40 and (close - low) > rangeBar * 0.45
sweepLow  = liqLowActive  and low  < ll40 and close > ll40 and (high - close) > rangeBar * 0.45

if useLiquidity and showLines and not compactVisuals
    if liqHighActive
        line.new(bar_index - liqLookback, hh40, bar_index, hh40, color=colLiq, style=line.style_dotted, width=1)
    if liqLowActive
        line.new(bar_index - liqLookback, ll40, bar_index, ll40, color=colLiq, style=line.style_dotted, width=1)
    if sweepHigh
        label.new(bar_index, high, "SWEEP↑", style=label.style_label_down, color=color.new(color.yellow, 25), textcolor=color.black, size=size.tiny)
    if sweepLow
        label.new(bar_index, low,  "SWEEP↓", style=label.style_label_up,   color=color.new(color.yellow, 25), textcolor=color.black, size=size.tiny)

// =====================================================================================
// SECTION 6 — PHASE 4 : S/R
// =====================================================================================
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_off)
dop = request.security(syminfo.tickerid, "D", open,    lookahead=barmerge.lookahead_off)

plot(useSR and showPDHL ? pdh : na, "PDH", color=color.new(#9b8cff, 0), style=plot.style_linebr)
plot(useSR and showPDHL ? pdl : na, "PDL", color=color.new(#9b8cff, 0), style=plot.style_linebr)
plot(useSR and showPWHL ? pwh : na, "PWH", color=color.new(#ff8bc4, 0), style=plot.style_linebr)
plot(useSR and showPWHL ? pwl : na, "PWL", color=color.new(#ff8bc4, 0), style=plot.style_linebr)
plot(useSR ? dop : na,             "DayOpen", color=color.new(#5db4ff, 0), style=plot.style_linebr)

roundAbove = math.ceil (close / roundStep) * roundStep
roundBelow = math.floor(close / roundStep) * roundStep
plot(useSR and showRoundLvls and not compactVisuals ? roundAbove : na, "Round↑", color=color.new(color.gray, 60), style=plot.style_circles)
plot(useSR and showRoundLvls and not compactVisuals ? roundBelow : na, "Round↓", color=color.new(color.gray, 60), style=plot.style_circles)

// =====================================================================================
// SECTION 7 — PHASE 5 : ORDER BLOCKS
// =====================================================================================
type OB
    float top
    float bot
    int   bornBar
    bool  bull
    bool  mitigated
    box   bx

var array<OB> bullOBs = array.new<OB>()
var array<OB> bearOBs = array.new<OB>()

displacementUp   = close > open and bodySize > atr * dispBodyATR
displacementDown = close < open and bodySize > atr * dispBodyATR
newBullOB = useOB and displacementUp and close[1] < open[1] and bosBull
newBearOB = useOB and displacementDown and close[1] > open[1] and bosBear

if newBullOB
    bx = obShow ? box.new(bar_index[1], high[1], bar_index + 60, low[1], border_color=color.new(colBull, 50), bgcolor=colOB_B) : na
    array.push(bullOBs, OB.new(high[1], low[1], bar_index[1], true, false, bx))
if newBearOB
    bx = obShow ? box.new(bar_index[1], high[1], bar_index + 60, low[1], border_color=color.new(colBear, 50), bgcolor=colOB_S) : na
    array.push(bearOBs, OB.new(high[1], low[1], bar_index[1], false, false, bx))

f_maintainOBs(arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            ob = array.get(arr, i)
            if not na(ob)
                expired = (bar_index - ob.bornBar) > obMaxAge
                mitig   = ob.bull ? close < ob.bot : close > ob.top
                if expired or mitig
                    if not na(ob.bx)
                        box.delete(ob.bx)
                    array.remove(arr, i)
                if not expired and not mitig
                    if not na(ob.bx)
                        box.set_right(ob.bx, bar_index + 5)
f_maintainOBs(bullOBs)
f_maintainOBs(bearOBs)

f_priceInOB(arr) =>
    found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            ob = array.get(arr, i)
            if not na(ob) and not ob.mitigated
                if low <= ob.top and high >= ob.bot
                    found := true
    found

inBullOB = f_priceInOB(bullOBs)
inBearOB = f_priceInOB(bearOBs)

// =====================================================================================
// SECTION 8 — PHASE 6 : FVG
// =====================================================================================
type FVG
    float top
    float bot
    int   bornBar
    bool  bull
    box   bx

var array<FVG> bullFVGs = array.new<FVG>()
var array<FVG> bearFVGs = array.new<FVG>()

bullFVGcond = useFVG and low > high[2] and (low - high[2]) > atr * fvgMinSizeATR
bearFVGcond = useFVG and high < low[2] and (low[2] - high) > atr * fvgMinSizeATR

if bullFVGcond
    bx = fvgShow ? box.new(bar_index[2], low, bar_index + 60, high[2], border_color=na, bgcolor=colFVG_B) : na
    array.push(bullFVGs, FVG.new(low, high[2], bar_index, true, bx))
if bearFVGcond
    bx = box(na)
    array.push(bearFVGs, FVG.new(low[2], high, bar_index, false, bx))

f_maintainFVGs(arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            g = array.get(arr, i)
            if not na(g)
                expired = (bar_index - g.bornBar) > fvgMaxAge
                filled  = g.bull ? close < g.bot : close > g.top
                if expired or filled
                    if not na(g.bx)
                        box.delete(g.bx)
                    array.remove(arr, i)
                if not expired and not filled
                    if not na(g.bx)
                        box.set_right(g.bx, bar_index + 5)
f_maintainFVGs(bullFVGs)
f_maintainFVGs(bearFVGs)

f_priceInFVG(arr) =>
    found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            g = array.get(arr, i)
            if not na(g)
                if low <= g.top and high >= g.bot
                    found := true
    found

inBullFVG = f_priceInFVG(bullFVGs)
inBearFVG = f_priceInFVG(bearFVGs)

// =====================================================================================
// SECTION 9 — PHASE 7 : CANDLE PSYCHOLOGY
// =====================================================================================
displacementBull = close > open and bodySize > atr * dispBodyATR
displacementBear = close < open and bodySize > atr * dispBodyATR
absorptionBull   = close > open and lowerWick / math.max(rangeBar, syminfo.mintick) > absorbWickPct
absorptionBear   = close < open and upperWick / math.max(rangeBar, syminfo.mintick) > absorbWickPct
bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
hammer     = lowerWick > bodySize * 2 and upperWick < bodySize * 0.4 and close > open
shooter    = upperWick > bodySize * 2 and lowerWick < bodySize * 0.4 and close < open

candleBullScore = (displacementBull ? 1 : 0) + (absorptionBull ? 1 : 0) + (bullEngulf ? 1 : 0) + (hammer ? 1 : 0)
candleBearScore = (displacementBear ? 1 : 0) + (absorptionBear ? 1 : 0) + (bearEngulf ? 1 : 0) + (shooter ? 1 : 0)

// =====================================================================================
// SECTION 10 — PHASE 8 : EMA TREND
// =====================================================================================
ema1 = ta.ema(close, ema1Len)
ema2 = ta.ema(close, ema2Len)
ema3 = ta.ema(close, ema3Len)
ema4 = ta.ema(close, ema4Len)
trendBullAlign = ema1 > ema2 and ema2 > ema3 and close > ema4
trendBearAlign = ema1 < ema2 and ema2 < ema3 and close < ema4
trendBias = trendBullAlign ? 1 : trendBearAlign ? -1 : 0
// COMMENTED: EMA plots
plot(useTrend ? ema1 : na, "EMA9",  color=color.new(#5db4ff, 0))
plot(useTrend ? ema2 : na, "EMA21", color=color.new(#9b8cff, 0))
plot(useTrend ? ema3 : na, "EMA50", color=color.new(#ff8bc4, 0))
plot(useTrend ? ema4 : na, "EMA200",color=color.new(#f5d76e, 0), linewidth=2)

// =====================================================================================
// SECTION 11 — PHASE 9 : MOMENTUM
// =====================================================================================
rsi  = ta.rsi(close, rsiLen)
[macdLine, macdSig, _h] = ta.macd(close, 12, 26, 9)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
momBull = rsi > rsiBull and macdLine > macdSig and adxVal > adxMin and diPlus > diMinus
momBear = rsi < rsiBear and macdLine < macdSig and adxVal > adxMin and diMinus > diPlus

// =====================================================================================
// SECTION 12 — PHASE 10 : VOLATILITY REGIME
// =====================================================================================
avgAtr   = ta.sma(atr, atrSqueezeLen)
squeeze  = atr < avgAtr * atrSqueezePct
expansion= atr > avgAtr * 1.3
regime   = adxVal > 25 and trendBias != 0 ? "TREND" : squeeze ? "SQUEEZE" : expansion ? "EXPANSION" : "RANGE"

// =====================================================================================
// SECTION 13 — PHASE 11 : ORB
// =====================================================================================
var float orbHigh = na
var float orbLow  = na
var bool  orbDone = false
if not na(time(timeframe.period, orbStart))
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow)  ? low  : math.min(orbLow,  low)
else if hour == 9 and minute == 15
    orbHigh := na
    orbLow  := na
    orbDone := false
isAfterORB = hour >= 9 and (hour > 9 or minute >= 30)
if isAfterORB
    orbDone := true

orbBreakUp = useORB and orbDone and not na(orbHigh) and close > (orbHigh + atr*orbBuffer) and close[1] <= orbHigh
orbBreakDn = useORB and orbDone and not na(orbLow)  and close < (orbLow  - atr*orbBuffer) and close[1] >= orbLow

// =====================================================================================
// SECTION 14 — PHASE 12 : BANKNIFTY
// =====================================================================================
bnfClose = request.security(bnfSymbol, timeframe.period, close,  lookahead=barmerge.lookahead_off)
bnfEmaF  = request.security(bnfSymbol, timeframe.period, ta.ema(close, ema1Len), lookahead=barmerge.lookahead_off)
bnfEmaS  = request.security(bnfSymbol, timeframe.period, ta.ema(close, ema3Len), lookahead=barmerge.lookahead_off)
bnfBull  = bnfClose > bnfEmaS and bnfEmaF > bnfEmaS
bnfBear  = bnfClose < bnfEmaS and bnfEmaF < bnfEmaS
bnfAlignBull = not useBNF or not bnfRequireAlign or bnfBull
bnfAlignBear = not useBNF or not bnfRequireAlign or bnfBear

// =====================================================================================
// SECTION 15 — PHASE 13 : VWAP
// =====================================================================================
vwap   = ta.vwap(hlc3)
vwapDev= ta.stdev(close - vwap, 20)
vwapUp = vwap + vwapDev * vwapDevMult
vwapDn = vwap - vwapDev * vwapDevMult
// COMMENTED: VWAP plots
plot(useVWAP ? vwap   : na, "VWAP",  color=color.new(#ffd97a, 0), linewidth=2)
plot(useVWAP ? vwapUp : na, "VWAP+", color=color.new(#ffd97a, 60))
plot(useVWAP ? vwapDn : na, "VWAP-", color=color.new(#ffd97a, 60))
vwapBull = close > vwap
vwapBear = close < vwap

// =====================================================================================
// SECTION 16 — PHASE 14 : MTF
// =====================================================================================
htfClose1 = request.security(syminfo.tickerid, htfBias,  close, lookahead=barmerge.lookahead_off)
htfEma1   = request.security(syminfo.tickerid, htfBias,  ta.ema(close, ema2Len), lookahead=barmerge.lookahead_off)
htfClose2 = request.security(syminfo.tickerid, htfTrend, close, lookahead=barmerge.lookahead_off)
htfEma2   = request.security(syminfo.tickerid, htfTrend, ta.ema(close, ema3Len), lookahead=barmerge.lookahead_off)
htfBullBias = (htfClose1 > htfEma1) and (htfClose2 > htfEma2)
htfBearBias = (htfClose1 < htfEma1) and (htfClose2 < htfEma2)
mtfBullOK = not useMTF or htfBullBias
mtfBearOK = not useMTF or htfBearBias

// =====================================================================================
// SECTION 17 — SCORING
// =====================================================================================
sStructBull = useStructure and structureBias == 1 ? 1 : 0
sStructBear = useStructure and structureBias == -1 ? 1 : 0
sBOSBull    = useBOS and bosBull ? 1 : 0
sBOSBear    = useBOS and bosBear ? 1 : 0
sLiqBull    = useLiquidity and sweepLow ? 1 : 0
sLiqBear    = useLiquidity and sweepHigh ? 1 : 0
sOBBull     = useOB and inBullOB ? 1 : 0
sOBBear     = useOB and inBearOB ? 1 : 0
sFVGBull    = useFVG and inBullFVG ? 1 : 0
sFVGBear    = useFVG and inBearFVG ? 1 : 0
sCdlBull    = useCandle and candleBullScore >= 2 ? 1 : 0
sCdlBear    = useCandle and candleBearScore >= 2 ? 1 : 0
sTrdBull    = useTrend and trendBias == 1 ? 1 : 0
sTrdBear    = useTrend and trendBias == -1 ? 1 : 0
sMomBull    = useMomentum and momBull ? 1 : 0
sMomBear    = useMomentum and momBear ? 1 : 0
sVolOK      = useVolatility and (regime == "TREND" or regime == "EXPANSION") ? 1 : 0
sBNFBull    = useBNF and bnfBull ? 1 : 0
sBNFBear    = useBNF and bnfBear ? 1 : 0
sVwapBull   = useVWAP and vwapBull ? 1 : 0
sVwapBear   = useVWAP and vwapBear ? 1 : 0
sMTFBull    = useMTF and htfBullBias ? 1 : 0
sMTFBear    = useMTF and htfBearBias ? 1 : 0

bullScore = sStructBull+sBOSBull+sLiqBull+sOBBull+sFVGBull+sCdlBull+sTrdBull+sMomBull+sVolOK+sBNFBull+sVwapBull+sMTFBull
bearScore = sStructBear+sBOSBear+sLiqBear+sOBBear+sFVGBear+sCdlBear+sTrdBear+sMomBear+sVolOK+sBNFBear+sVwapBear+sMTFBear
maxScore  = (useStructure?1:0)+(useBOS?1:0)+(useLiquidity?1:0)+(useOB?1:0)+(useFVG?1:0)+(useCandle?1:0)+(useTrend?1:0)+(useMomentum?1:0)+(useVolatility?1:0)+(useBNF?1:0)+(useVWAP?1:0)+(useMTF?1:0)
normBull = maxScore == 0 ? 0 : math.round(bullScore * 10 / maxScore)
normBear = maxScore == 0 ? 0 : math.round(bearScore * 10 / maxScore)

// =====================================================================================
// SECTION 18 — FAKEOUT FILTER
// =====================================================================================
weakBreakout = useFakeout and volume < avgVol * 0.8
exhaustedRun = useFakeout and (rsi > 78 or rsi < 22)
fakeoutBlock = weakBreakout or exhaustedRun

// =====================================================================================
// SECTION 19 — ENTRY LOGIC
// =====================================================================================
contBull = bosBull and (inBullOB or inBullFVG) and trendBias == 1 and momBull and bnfAlignBull and mtfBullOK and not fakeoutBlock
contBear = bosBear and (inBearOB or inBearFVG) and trendBias == -1 and momBear and bnfAlignBear and mtfBearOK and not fakeoutBlock
revBull  = sweepLow  and (chochBull or (close > open and candleBullScore >= 2)) and bnfAlignBull and mtfBullOK and not fakeoutBlock
revBear  = sweepHigh and (chochBear or (close < open and candleBearScore >= 2)) and bnfAlignBear and mtfBearOK and not fakeoutBlock
brBull   = orbBreakUp and trendBias != -1 and bnfAlignBull and mtfBullOK and not fakeoutBlock
brBear   = orbBreakDn and trendBias !=  1 and bnfAlignBear and mtfBearOK and not fakeoutBlock

bullSignal = allowLong  and inSession and normBull >= minScore and (contBull or revBull or brBull)
bearSignal = allowShort and inSession and normBear >= minScore and (contBear or revBear or brBear)

var int lastTradeBar = na
canTradeBar = not oneTradePerBar or (na(lastTradeBar) or bar_index > lastTradeBar)
setupTxt   = bullSignal ? (contBull?"Continuation":revBull?"LiquidityRev":"BreakRetest") : bearSignal ? (contBear?"Continuation":revBear?"LiquidityRev":"BreakRetest") : ""

// =====================================================================================
// SECTION 20 — RISK
// =====================================================================================
swingSL_long  = na(lastSwingLow)  ? close - atr * atrSLmult : math.min(lastSwingLow,  low) - atr * 0.2
swingSL_short = na(lastSwingHigh) ? close + atr * atrSLmult : math.max(lastSwingHigh, high) + atr * 0.2
atrSL_long    = close - atr * atrSLmult
atrSL_short   = close + atr * atrSLmult
liqSL_long    = na(ll40) ? atrSL_long  : math.min(ll40, low)  - atr * 0.15
liqSL_short   = na(hh40) ? atrSL_short : math.max(hh40, high) + atr * 0.15
slLong  = riskMode == "Swing" ? swingSL_long  : riskMode == "Liquidity" ? liqSL_long  : atrSL_long
slShort = riskMode == "Swing" ? swingSL_short : riskMode == "Liquidity" ? liqSL_short : atrSL_short

rPerLong  = close - slLong
rPerShort = slShort - close
tp1L = close + rPerLong * tp1RR
tp2L = close + rPerLong * tp2RR
tp3L = close + rPerLong * tp3RR
tp1S = close - rPerShort * tp1RR
tp2S = close - rPerShort * tp2RR
tp3S = close - rPerShort * tp3RR

rrLongOK  = (rPerLong  > 0) and ((tp1L - close) / rPerLong  >= minRR)
rrShortOK = (rPerShort > 0) and ((close - tp1S) / rPerShort >= minRR)

finalBuy  = bullSignal and rrLongOK  and canTradeBar
finalSell = bearSignal and rrShortOK and canTradeBar

// =====================================================================================
// SECTION 21 — RIGID MARKER EXECUTION (INSTITUTIONAL LOGIC)
// =====================================================================================
var int position = 0
var float current_sl = na
var float current_tp = na
var float current_entry = na

triggered_buy = false
triggered_sell = false
triggered_exit_buy = false
triggered_exit_sell = false

if finalBuy and position == 0
    position := 1
    current_entry := close
    current_sl := slLong
    current_tp := tp2L // Targeting TP2 for exit marker
    triggered_buy := true
    if isStrategy
        strategy.entry("Long", strategy.long)
    label.new(bar_index, low, "BUY\nEntry: " + str.tostring(current_entry, format.mintick) + "\nSL: " + str.tostring(current_sl, format.mintick) + "\nTP: " + str.tostring(current_tp, format.mintick), style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, yloc=yloc.price)

if finalSell and position == 0
    position := -1
    current_entry := close
    current_sl := slShort
    current_tp := tp2S // Targeting TP2 for exit marker
    triggered_sell := true
    if isStrategy
        strategy.entry("Short", strategy.short)
    label.new(bar_index, high, "SELL\nEntry: " + str.tostring(current_entry, format.mintick) + "\nSL: " + str.tostring(current_sl, format.mintick) + "\nTP: " + str.tostring(current_tp, format.mintick), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, yloc=yloc.price)

// Update Trailing Stop or exit if hit
if position == 1
    if useTrail and high >= tp2L
        new_sl = close - (atr * trailAtrMult)
        current_sl := na(current_sl) ? new_sl : math.max(current_sl, new_sl)
    if close <= current_sl or close >= tp3L
        triggered_exit_buy := true
    if isStrategy and not na(current_sl)
        strategy.exit("Long Exit", from_entry="Long", stop=current_sl, limit=tp3L)

if position == -1
    if useTrail and low <= tp2S
        new_sl = close + (atr * trailAtrMult)
        current_sl := na(current_sl) ? new_sl : math.min(current_sl, new_sl)
    if close >= current_sl or close <= tp3S
        triggered_exit_sell := true
    if isStrategy and not na(current_sl)
        strategy.exit("Short Exit", from_entry="Short", stop=current_sl, limit=tp3S)

if triggered_exit_buy
    if isStrategy
        strategy.close("Long")
    exitPrice = close <= current_sl ? current_sl : current_tp
    pnlPts = not na(current_entry) ? exitPrice - current_entry : na
    pnlPct = not na(current_entry) and current_entry != 0 ? pnlPts / current_entry * 100.0 : na
    label.new(bar_index, high, "EXIT\nExit: " + str.tostring(exitPrice, format.mintick) + "\nP&L: " + str.tostring(pnlPts, format.mintick) + " (" + str.tostring(pnlPct, "#.##") + "%)", style=label.style_label_down, color=pnlPts >= 0 ? color.green : color.red, textcolor=color.white, yloc=yloc.price)
    position := 0
    current_sl := na
    current_tp := na
    current_entry := na

if triggered_exit_sell
    if isStrategy
        strategy.close("Short")
    exitPrice = close >= current_sl ? current_sl : current_tp
    pnlPts = not na(current_entry) ? current_entry - exitPrice : na
    pnlPct = not na(current_entry) and current_entry != 0 ? pnlPts / current_entry * 100.0 : na
    label.new(bar_index, low, "EXIT\nExit: " + str.tostring(exitPrice, format.mintick) + "\nP&L: " + str.tostring(pnlPts, format.mintick) + " (" + str.tostring(pnlPct, "#.##") + "%)", style=label.style_label_up, color=pnlPts >= 0 ? color.green : color.red, textcolor=color.white, yloc=yloc.price)
    position := 0
    current_sl := na
    current_tp := na
    current_entry := na

// =====================================================================================
// SECTION 22 — VISUALIZATION (RIGID PLOTSHAPES ONLY)
// =====================================================================================
plotshape(triggered_buy, style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white, size=size.normal)
plotshape(triggered_sell, style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white, size=size.normal)
plotshape(triggered_exit_buy or triggered_exit_sell, style=shape.labeldown, location=location.abovebar, color=color.orange, text="EXIT", textcolor=color.white, size=size.small)

activeLong  = position == 1
activeShort = position == -1

plot(activeLong and showLines ? current_sl : na, "Long SL", color=color.new(colBear, 0), style=plot.style_linebr, linewidth=2)
plot(activeLong and showLines ? current_tp : na, "Long TP", color=color.new(colBull, 0), style=plot.style_linebr, linewidth=2)
plot(activeShort and showLines ? current_sl : na, "Short SL", color=color.new(colBull, 0), style=plot.style_linebr, linewidth=2)
plot(activeShort and showLines ? current_tp : na, "Short TP", color=color.new(colBear, 0), style=plot.style_linebr, linewidth=2)

// =====================================================================================
// END  —  NIFTY INSTITUTIONAL HUNTER  [15m]
// =====================================================================================
